    "Choose the date on which this request should be automatically approved. You can approve it earlier at any time from the Waiting tab." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر التاريخ الذي يجب أن تتم فيه الموافقة على هذا الطلب تلقائيًا. يمكنك الموافقة عليه مبكرًا في أي وقت من علامة التبويب \"الانتظار\"."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose the date on which this request should be automatically approved. You can approve it earlier at any time from the Waiting tab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elija la fecha en la que esta solicitud debe aprobarse automáticamente. Puedes aprobarlo antes en cualquier momento desde la pestaña Esperando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez la date à laquelle cette demande doit être automatiquement approuvée. Vous pouvez l'approuver plus tôt à tout moment depuis l'onglet En attente."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वह तिथि चुनें जिस दिन यह अनुरोध स्वचालित रूप से स्वीकृत हो जाना चाहिए। आप इसे वेटिंग टैब से किसी भी समय पहले स्वीकृत कर सकते हैं।"
          }
        }
      }
    },
