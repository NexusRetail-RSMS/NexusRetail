    "Track and organize upcoming promotional events and product launches." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتبع وتنظيم الأحداث الترويجية القادمة وإطلاق المنتجات."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Track and organize upcoming promotional events and product launches."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Realice un seguimiento y organice los próximos eventos promocionales y lanzamientos de productos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suivez et organisez les événements promotionnels et les lancements de produits à venir."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आगामी प्रचार कार्यक्रमों और उत्पाद लॉन्च को ट्रैक और व्यवस्थित करें।"
          }
        }
      }
    },
    "Track and update items currently in queue for diagnostics or repair." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتبع وتحديث العناصر الموجودة حاليًا في قائمة الانتظار للتشخيص أو الإصلاح."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Track and update items currently in queue for diagnostics or repair."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Realice un seguimiento y actualice los elementos actualmente en cola para diagnóstico o reparación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suivez et mettez à jour les éléments actuellement en file d’attente pour diagnostic ou réparation."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "निदान या मरम्मत के लिए वर्तमान में कतार में मौजूद वस्तुओं को ट्रैक और अपडेट करें।"
          }
        }
      }
    },
    "Track performance, assign managers, and stay in sync across locations." : {
      "comment" : "Subtitle for the \"Manage Every Store\" section of the onboarding flow.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتبع الأداء، وقم بتعيين المديرين، وابق متزامنًا عبر المواقع."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Track performance, assign managers, and stay in sync across locations."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Realice un seguimiento del rendimiento, asigne administradores y manténgase sincronizado en todas las ubicaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suivez les performances, affectez des responsables et restez synchronisé sur tous les sites."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रदर्शन को ट्रैक करें, प्रबंधकों को नियुक्त करें और सभी स्थानों पर समन्वय बनाए रखें।"
          }
        }
      }
    },
