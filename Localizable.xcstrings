    "At least one payment gateway is configured. You can now accept payments.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At least one payment gateway is configured. You can now accept payments."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कम से कम एक भुगतान गेटवे कॉन्फ़िगर किया गया है। अब आप भुगतान स्वीकार कर सकते हैं."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au moins une passerelle de paiement est configurée. Vous pouvez désormais accepter les paiements."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تكوين بوابة دفع واحدة على الأقل. يمكنك الآن قبول المدفوعات."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al menos una pasarela de pago está configurada. Ahora puedes aceptar pagos."
          }
        }
      }
    },
    "Store cannot process payments until at least one payment gateway is configured.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Store cannot process payments until at least one payment gateway is configured."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब तक कम से कम एक भुगतान गेटवे कॉन्फ़िगर नहीं हो जाता, स्टोर भुगतान संसाधित नहीं कर सकता।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Store ne peut pas traiter les paiements tant qu'au moins une passerelle de paiement n'est pas configurée."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن للمتجر معالجة المدفوعات حتى يتم تكوين بوابة دفع واحدة على الأقل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tienda no puede procesar pagos hasta que se configure al menos una pasarela de pago."
          }
        }
      }
    },
