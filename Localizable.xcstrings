    "Are you sure you want to delete this manager? This action cannot be undone and will revoke their access.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to delete this manager? This action cannot be undone and will revoke their access."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या आप वाकई इस प्रबंधक को हटाना चाहते हैं? यह कार्रवाई पूर्ववत नहीं की जा सकती और उनकी पहुंच रद्द कर दी जाएगी."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Êtes-vous sûr de vouloir supprimer ce gestionnaire ? Cette action ne peut être annulée et révoquera leur accès."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل أنت متأكد أنك تريد حذف هذا المدير؟ لا يمكن التراجع عن هذا الإجراء وسيؤدي إلى إلغاء وصولهم."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Estás seguro de que deseas eliminar este administrador? Esta acción no se puede deshacer y revocará su acceso."
          }
        }
      }
    },
