    "Configure payment gateways for your store so you can start accepting payments.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure payment gateways for your store so you can start accepting payments."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने स्टोर के लिए भुगतान गेटवे कॉन्फ़िगर करें ताकि आप भुगतान स्वीकार करना शुरू कर सकें।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurez les passerelles de paiement pour votre boutique afin de pouvoir commencer à accepter des paiements."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتكوين بوابات الدفع لمتجرك حتى تتمكن من البدء في قبول المدفوعات."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura pasarelas de pago para tu tienda para que puedas comenzar a aceptar pagos."
          }
        }
      }
    },
