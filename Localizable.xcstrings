    "A store must have a manager assigned before it can be marked as active.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A store must have a manager assigned before it can be marked as active."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी स्टोर को सक्रिय के रूप में चिह्नित करने से पहले उसके पास एक प्रबंधक नियुक्त होना चाहिए।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un magasin doit avoir un responsable affecté avant de pouvoir être marqué comme actif."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
