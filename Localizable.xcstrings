    "Are you sure you want to delete this employee? This action cannot be undone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to delete this employee? This action cannot be undone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या आप वाकई इस कर्मचारी को हटाना चाहते हैं? इस एक्शन को वापस नहीं किया जा सकता।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Êtes-vous sûr de vouloir supprimer cet employé ? Cette action ne peut pas être annulée."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل أنت متأكد أنك تريد حذف هذا الموظف؟ لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Está seguro de que desea eliminar a este empleado? Esta acción no se puede deshacer."
          }
        }
      }
    },
